# Copie para .env.production apenas no servidor. Não versionar o arquivo real.
POSTGRES_DB=reconcileflow
POSTGRES_USER=reconcileflow
POSTGRES_PASSWORD=troque-por-um-segredo-longo-e-aleatorio

# Origem HTTPS exposta pelo gateway reverso.
PUBLIC_ORIGIN=https://reconcileflow.exemplo.com

# O serviço web fica local ao servidor; o gateway publica HTTPS.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

RECONCILEFLOW_LOG_LEVEL=INFO
RECONCILEFLOW_OTEL_ENABLED=false
